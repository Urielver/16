rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return (request.auth != null && request.auth.token.email == 'carlosvargasotorgues@gmail.com') ||
             (request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidMemory(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.author is string && data.author.size() <= 150 &&
             data.image is string && data.image.size() <= 2000000 &&
             data.timestamp is number;
    }

    // Colección de recuerdos de fotos de la fiesta en Google Cloud
    match /memories/{memoryId} {
      // Todos los invitados y la pantalla gigante pueden ver las fotos
      allow get, list: if true;

      // Cualquier invitado puede publicar una foto en Google Cloud
      allow create: if isValidId(memoryId);

      // Me gusta y actualizaciones
      allow update: if true;

      // Borrado de fotos
      allow delete: if true;
    }

    // Presencia en vivo de invitados conectados
    match /presence/{presenceId} {
      allow read, write: if true;
    }

    // Playlist colaborativa de canciones de la fiesta (YouTube & Spotify)
    match /playlist/{songId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Configuración global del evento
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin() || true;
    }

    // Colección de administradores
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
